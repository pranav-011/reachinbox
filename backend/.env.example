# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=supersecretreachinboxjwtkey1234567890!
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL via Docker or local)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR_PER_SENDER=50
GLOBAL_MAX_EMAILS_PER_HOUR=200

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Fake SMTP (Ethereal Email) - auto-generated if left empty
ETHEREAL_USER=
ETHEREAL_PASS=

# Google OAuth (Optional: leave empty to test with demo login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth & Notifications (Optional: connect via UI or specify incoming webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5001/api/slack/oauth/callback
DEFAULT_SLACK_WEBHOOK_URL=
